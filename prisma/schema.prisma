datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RepositoryFiles {
  id        String  @id @default(cuid())
  path      String
  name      String
  extension String?
  content   String? @db.Text

  repositoryId String
  // dependencies CodeDependency[]
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, path])
}

model CodeDependency {
  id String @id @default(cuid())

  sourceFile   String
  targetPath   String
  resolvedPath String?
  importName   String?
  isExternal   Boolean @default(false)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([repositoryId, sourceFile, targetPath, importName])
  @@index([repositoryId])
  @@index([sourceFile])
}

model Repository {
  id            String  @id @default(cuid())
  githubId      String  @unique
  name          String
  fullName      String
  description   String?
  url           String
  defaultBranch String
  owner         String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  files        RepositoryFiles[]
  codeEntities CodeEntity[]
  dependencies CodeDependency[]
  chunks       CodeChunk[]
  chats        ChatConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatConversation {
  id           String     @id @default(cuid())
  title        String
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([repositoryId])
  @@index([updatedAt])
}

model ChatMessage {
  id      String @id @default(cuid())
  role    String
  content String @db.Text

  // The exact search results returned for this assistant response.
  results Json?

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model CodeChunk {
  id String @id @default(cuid())

  content String @db.Text

  filePath  String
  startLine Int
  endLine   Int

  entityId String?
  entity   CodeEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([repositoryId])
  @@index([filePath])
  @@index([entityId])
}

model CodeEntity {
  id String @id @default(cuid())

  type     String
  name     String
  filePath String

  startLine Int?
  endLine   Int?

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  chunks    CodeChunk[]
  createdAt DateTime    @default(now())

  @@unique([repositoryId, filePath, name, type, startLine])
  @@index([repositoryId])
  @@index([filePath])
  @@index([name])
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  isGithubConnected   Boolean  @default(false)
  githubTokenExpiresAt  DateTime?
  accounts      Account[]
  sessions      Session[]
  repositories  Repository[]
}
